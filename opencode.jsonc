{
    "$schema": "https://opencode.ai/config.json",
    "instructions": [],
    "formatter": true,
    "mcp": {
      "servers": {
        "github": {
          "type": "remote",
          "url": "https://api.githubcopilot.com/mcp/",
          "oauth": false,
          "headers": {
            "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
          }
        }
      }
    },
}